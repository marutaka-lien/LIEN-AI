# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright persistent browser profile(RMSログインCookie等の秘匿情報を含む)
/playwright/.auth/
/playwright-report/
/test-results/

# Claude Code local settings(個人用の権限設定など)
/.claude/settings.local.json

# レビュー全履歴アーカイブ(顧客のレビュー内容を含むため、Git管理対象外とする)
/data/

# ローカル開発DB(実顧客の個人情報を含むため、Git管理対象外とする)
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm

# 実行時ログ(注文番号等の個人情報が混入し得るため、Git管理対象外とする)
/logs/
