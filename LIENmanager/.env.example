# このファイルには変数名のみを記載する。実際の値は .env に設定し、Gitへコミットしないこと。

# Prisma (SQLite)
DATABASE_URL="file:./dev.db"

# 楽天RMS Web Service API
# RMS管理画面の「API連携」設定から取得する(serviceSecret / licenseKey)。
RMS_SERVICE_SECRET=
RMS_LICENSE_KEY=
# 2026-07-22 実APIへのDry Runで疎通確認済み(店舗共通の固定値)。
RMS_API_BASE_URL=https://api.rms.rakuten.co.jp
RMS_SEARCH_ORDER_PATH=/es/2.0/order/searchOrder/
RMS_GET_ORDER_PATH=/es/2.0/order/getOrder/
# getOrderの必須パラメータ。1・2は不正値、3で成功することをDry Runで確認済み。
RMS_GET_ORDER_VERSION=3
# 同期時に検索する直近日数(デフォルト14日)
RMS_SEARCH_LOOKBACK_DAYS=14
# 1回のsearchOrderリクエストで指定できる最大日数(保守的に63日を上限とする)
RMS_SEARCH_MAX_WINDOW_DAYS=63
# 1ページあたりの最大取得件数(RMS上限1000件、既定は控えめな値)
RMS_SEARCH_MAX_RECORDS_PER_PAGE=200
# リクエスト間隔(ミリ秒)
RMS_REQUEST_INTERVAL_MS=1000
# リクエストタイムアウト(ミリ秒)
RMS_REQUEST_TIMEOUT_MS=30000

# 楽天RMS ブラウザ操作(Playwright)関連
# 2026-07-22 実画面で確認したRMSログイン後の正式な入口URL。
RMS_MAINMENU_URL=https://mainmenu.rms.rakuten.co.jp/rms
# 2026-07-22 実画面で確認済みのURL。
RMS_ORDER_SEARCH_URL=https://order-rp.rms.rakuten.co.jp/order-rb/search-order-sc/init
RMS_ORDER_DETAIL_URL_TEMPLATE=https://order-rp.rms.rakuten.co.jp/order-rb/individual-order-detail-sc/init?orderNumber={orderNumber}
RMS_ORDER_LIST_PENDING_CONFIRMATION_URL=https://order-rp.rms.rakuten.co.jp/order-rb/order-list-sc/init?&SEARCH_MODE=1&ORDER_PROGRESS=100
# Persistent Context(ログインセッション)の保存先。Git管理対象外。
RMS_BROWSER_PROFILE_DIR=playwright/.auth/rms-profile

# RMS自動注文確認スケジューラ(src/instrumentation.ts経由でサーバー起動時に自動開始)
# 通常のOrchestrator(手動実行)とは独立して、orderProgress=100の注文を定期的に
# 検出し、実際に「注文確認」ボタンをクリックする(execute:true固定)。
# falseにすると起動時にこの機能全体を無効化できる。
RMS_AUTO_CONFIRM_ENABLED=true
# 巡回間隔(ミリ秒)。RMSにWebhookが無いための近似ポーリング(既定2分)。
RMS_AUTO_CONFIRM_INTERVAL_MS=120000

# ClickPost ブラウザ操作(Playwright)関連
# 2026-07-23 実画面で確認: ClickPost独自のログイン画面は存在せず、
# Yahoo! JAPAN ID / AmazonアカウントによるOAuthログインのみ。
# そのためログインは自動化せず、表示されたブラウザでユーザーが手動で行う。
CLICKPOST_TOP_URL=https://clickpost.jp/
CLICKPOST_MYPAGE_URL=https://clickpost.jp/mypage/index
# Persistent Context(ログインセッション)の保存先。Git管理対象外。
CLICKPOST_BROWSER_PROFILE_DIR=playwright/.auth/clickpost-profile

# RMSレビューチェックツール(review.rms.rakuten.co.jp)
# RMSと同一R-Login SSOセッションのため、RMS_BROWSER_PROFILE_DIRを共有する
# (専用のプロファイル変数は不要)。
RMS_REVIEW_TOOL_URL=https://review.rms.rakuten.co.jp/search/index/

# レビュー返信文自動生成(Anthropic Claude API)
# https://console.anthropic.com/ で発行したAPIキーを設定する。
ANTHROPIC_API_KEY=
# 未設定時はコスト効率重視でHaiku系を使う。文面の品質を優先する場合は変更する。
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# trueにすると、一括返信ジョブがAI生成に続けて実際にRMSへ投稿する(既定はfalse=下書き
# 生成のみ)。rms-review.selectorsのreviewReplySelectorsを実画面で検証してから有効化すること。
RMS_REVIEW_REPLY_EXECUTE=false

# レビューの保持ポリシー(レビュー同期のたびに自動実行される)
# アプリのDB(dev.db)には直近REVIEW_RETENTION_MONTHSヶ月分のみを残し、それより古い
# レビューはREVIEW_ARCHIVE_DIR配下のreviews.jsonl(1行1レビューのJSON、アプリのDBとは
# 別ファイル)へ追記してからDBから削除する。相対パスの場合はプロジェクトルート基準。
REVIEW_ARCHIVE_DIR=data/review-archive
REVIEW_RETENTION_MONTHS=6
